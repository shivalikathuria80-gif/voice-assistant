{
  "servers": {
    "search": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@0.2.22"],
      "env": { "TAVILY_API_KEY": "${TAVILY_API_KEY}" }
    },
    "calendar": {
      "command": "npx",
      "args": ["-y", "@cocal/google-calendar-mcp"],
      "env": { "GOOGLE_OAUTH_CREDENTIALS": "${GOOGLE_OAUTH_CREDENTIALS}" }
    }
  }
}
