# Required: https://console.groq.com/keys (used for STT + LLM)
GROQ_API_KEY=

# Optional: https://console.deepgram.com (server-side TTS). If empty, the browser's speechSynthesis is used.
DEEPGRAM_API_KEY=

PORT=3002
STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=llama-3.3-70b-versatile
TTS_VOICE=aura-asteria-en
SYSTEM_PROMPT=You are a friendly voice assistant. Reply in one to three short spoken sentences. No markdown, lists, or emojis.
