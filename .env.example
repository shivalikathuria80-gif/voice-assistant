# Required: https://console.groq.com/keys (used for STT + LLM)
GROQ_API_KEY=

# Optional: https://console.deepgram.com (server-side TTS). If empty, the browser's speechSynthesis is used.
DEEPGRAM_API_KEY=

# Optional: https://elevenlabs.io (most natural voice). Takes priority over Deepgram when set.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional MCP servers (see README, section Tools and approvals)
TAVILY_API_KEY=

PORT=3002
STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-120b
TTS_VOICE=aura-asteria-en
SYSTEM_PROMPT=You are a friendly voice assistant. Reply in one to three short spoken sentences. No markdown, lists, or emojis.
